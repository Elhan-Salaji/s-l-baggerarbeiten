# Vorlage: nach .env kopieren und ausfüllen. Die .env bleibt auf dem
# Server und gehört nicht ins Repository.

# SMTP-Zugang für den Mailversand des Kontaktformulars
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Absender und Empfänger. Der Absender muss zum SMTP-Konto passen,
# sonst greifen SPF/DKIM nicht. Beim Empfänger sind mehrere Adressen
# erlaubt, durch Komma getrennt.
MAIL_FROM=info@s-l-baggerarbeiten.de
MAIL_RECIPIENT=info@s-l-baggerarbeiten.de, s.l.baggerarbeiten@web.de

# E-Mail für das Let's-Encrypt-Konto (Ablauf-Hinweise)
ACME_EMAIL=
